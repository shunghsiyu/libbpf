# Appended to the x86 defconfig + kvm_guest.config (step 3 of the workflow).

# --- What vmtest needs to boot (same list as the kernel's own
# --- tools/testing/selftests/bpf/config.vm).
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_9P_FS_SECURITY=y
CONFIG_CRYPTO_DEV_VIRTIO=y
CONFIG_FUSE_FS=y
CONFIG_FUSE_PASSTHROUGH=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_FS=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y
CONFIG_VSOCKETS=y

# libbpf/ci's VM init script mounts bpffs, so the kernel must offer it.
CONFIG_BPF_SYSCALL=y

# --- Keep the build fast and `uname -r` predictable.
# No modules: anything that was =m becomes =n, which shrinks the build a lot.
# CONFIG_MODULES is not set
# No "-gabcdef" suffix on the version string.
# CONFIG_LOCALVERSION_AUTO is not set
# No debug info, so no pahole/BTF needed.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
